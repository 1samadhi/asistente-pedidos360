# Asistente de integracion Pedidos360 — copia a .env y completa.
# El .env NUNCA se sube: el repositorio es publico.

# --- API de Pedidos360 ---
# Despliegue en AWS. Para trabajar sin el laboratorio, levanta Pedidos360 en
# local (docker compose -f docker-compose.yml -f docker-compose.local.yml up)
# y apunta a http://localhost:8082 — la IP publica del lab cambia al reiniciar.
PEDIDOS360_URL="https://TU-API.execute-api.us-east-1.amazonaws.com/desarrollo"

# --- Entra ID ---
# Las rutas de negocio del API Gateway usan el autorizador de Entra ID, no el
# del IdP propio: un token de ms-auth recibe 401 en /v1/pedidos.
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_APP_ID_URI=""
ENTRA_USUARIO_CLIENTE=""
ENTRA_PASSWORD_CLIENTE=""

# --- Recuperacion (opcional; los valores por defecto estan en config.py) ---
# TAMANO_CHUNK="900"
# SOLAPE_CHUNK="150"
# K_RECUPERACION="4"
