# Asistente de integracion Pedidos360 — copia a .env y completa.
# El .env NUNCA se sube: el repositorio es publico.

# --- Modelo de lenguaje (obligatorio) ---
# API key de Groq, gratuita en https://console.groq.com/ > API Keys. Empieza con "gsk_".
# Sin ella el asistente no puede redactar respuestas.
GROQ_API_KEY=""

# --- API de Pedidos360 ---
# Dos modos. Por defecto "gateway": el API Gateway de AWS unifica los
# microservicios bajo un host y publica las rutas como /v1/...
PEDIDOS360_MODO="gateway"
PEDIDOS360_URL="https://TU-API.execute-api.us-east-1.amazonaws.com/desarrollo"

# Modo "directo": Pedidos360 corriendo en local con Docker, sin gateway. Cada
# microservicio en su puerto y con su prefijo real /api/v1/..., y basta el login
# del IdP propio porque el autorizador de Entra vive en el gateway, que aqui no
# interviene. Sirve para trabajar sin depender del laboratorio de AWS.
#
#   PEDIDOS360_MODO="directo"
#   MS_AUTH_USUARIO="cliente"
#   MS_AUTH_PASSWORD="..."
#
# Los puertos por defecto (8082 pedidos, 8081 productos, 9000 auth) se pueden
# cambiar con PEDIDOS360_PEDIDOS_URL, PEDIDOS360_PRODUCTOS_URL y
# PEDIDOS360_AUTH_URL.

# --- Entra ID ---
# Las rutas de negocio del API Gateway usan el autorizador de Entra ID, no el
# del IdP propio: un token de ms-auth recibe 401 en /v1/pedidos.
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_APP_ID_URI=""
ENTRA_USUARIO_CLIENTE=""
ENTRA_PASSWORD_CLIENTE=""

# --- Recuperacion (opcional; los valores por defecto estan en config.py) ---
# TAMANO_CHUNK="900"
# SOLAPE_CHUNK="150"
# K_RECUPERACION="4"

# --- LangSmith · trazas de cada ejecucion (opcional) ---
# Registra cada consulta: que herramienta eligio el modelo, que fragmentos
# recupero, cuanto tardo y cuantos tokens gasto. Util para depurar y como
# evidencia de observabilidad.
#
# Clave gratuita en https://smith.langchain.com > Settings > API Keys.
# Dejar TRACING en "false" hasta tener la clave: con la clave vacia, LangChain
# intenta enviar las trazas igual y la consola se llena de errores 401.
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="asistente-pedidos360"
